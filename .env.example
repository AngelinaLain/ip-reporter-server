# 使用 scripts/init-server.ps1 或 sh scripts/init-server.sh 生成随机密钥。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
REPORT_TOKEN=
# AES-256 密钥：32 个随机字节的 Base64，必须随数据库备份保留。
APP_ENCRYPTION_KEY=
DB_PASSWORD=
APP_PORT=18080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
OFFLINE_SECONDS=900
DDNS_SYNC_SECONDS=60

# 可选的 OpenID Connect SSO。回调地址为 https://你的域名/login/oauth2/code/sso。
SSO_ENABLED=false
SSO_REGISTRATION_ID=sso
SSO_PROVIDER_NAME=企业 SSO
SSO_ISSUER_URI=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# HTTPS 反向代理部署建议明确填写公网回调地址。
SSO_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SSO_SCOPES=openid,profile,email
# 可选权限限制，例如 groups 与 ip-reporter-admins；留空表示接受该 OIDC 租户中的所有账户。
SSO_ADMIN_CLAIM=
SSO_ADMIN_VALUES=

# 服务端发布镜像：固定版本便于回滚，也可改为后续发布的版本。
IMAGE_PREFIX=ghcr.io/angelinalain/ip-reporter-server
IMAGE_TAG=1.1.3

# 客户端仓库的 owner/repo。留空时镜像服务保持空闲。
CLIENT_GITHUB_REPOSITORY=AngelinaLain/ip-reporter-client
# 私有仓库才需要，令牌仅授予该仓库 Contents 读取权限。
CLIENT_GITHUB_TOKEN=
# 留空追踪 GitHub 最新正式版本，也可固定到 v1.1.1 等标签。
CLIENT_RELEASE_TAG=
CLIENT_SYNC_INTERVAL_SECONDS=3600
CLIENT_KEEP_RELEASES=2
